NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=agent-tool-server-shopping
SERVICE_VERSION=0.1.0
GIT_SHA=unknown
PUBLIC_BASE_URL=

# Development only. Production rejects disabled authentication.
AUTH_MODE=disabled
API_KEYS=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Mutations are disabled unless both deployment and request explicitly permit them.
# (These tools are all read-only today; guardrails are retained for future write tools.)
MUTATIONS_ENABLED=false
MUTATION_CONFIRMATION_REQUIRED=true

# SerpApi credentials, kept separate from AUTH_MODE/API_KEYS. Required in production.
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com
SERPAPI_TIMEOUT_MS=8000
SERPAPI_MAX_RETRIES=2
SERPAPI_RETRY_BASE_DELAY_MS=250

# Bounded defaults for shopping result sizes and locale. DEFAULT must not exceed MAX.
SHOPPING_DEFAULT_RESULTS=10
SHOPPING_MAX_RESULTS=40
SHOPPING_DEFAULT_COUNTRY=us
SHOPPING_DEFAULT_LANGUAGE=en
